class Solution {
    public int mySqrt(int x) {
 if(x == 0 || x == 1) {
    return x;
 }
    long left = 1;
    long longRight = x;
    int ans = 0;
while(left <= longRight) {
    long mid = left + (longRight - left) / 2;
    if(mid * mid == x) {
        return (int) mid;
        }else if (mid * mid < x) {
            ans = (int) mid; 
            left = mid + 1;
        }else{
            longRight = mid - 1;
        }
}
return ans;
 }
}
